generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Registration {
  id                 String   @id @default(cuid())
  ticketId           String   @unique @db.VarChar(32)
  teamName           String   @db.VarChar(40)
  normalizedTeamName String   @unique @db.VarChar(40)
  createdAt          DateTime @default(now())
  checkedInAt        DateTime?
  members            TeamMember[]

  @@index([createdAt])
  @@index([checkedInAt])
}

model TeamMember {
  id              String       @id @default(cuid())
  registrationId  String
  registration    Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  position        Int
  fullName        String       @db.VarChar(100)
  email           String       @db.VarChar(254)
  normalizedEmail String       @unique @db.VarChar(254)
  phone           String       @db.VarChar(16)
  normalizedPhone String       @unique @db.VarChar(10)
  college         String       @db.VarChar(80)

  @@unique([registrationId, position])
  @@index([college])
  @@index([registrationId])
}

model RegistrationRateLimit {
  key           String   @id @db.VarChar(128)
  windowStarted DateTime
  attempts      Int      @default(0)
  updatedAt     DateTime @updatedAt
}
