# Supabase: pooled URL for server runtime and direct URL for Prisma CLI migrations.
# Supabase pooler may require `?pgbouncer=true&sslmode=no-verify` for Prisma's pg adapter.
DATABASE_URL=
DIRECT_URL=

# Public browser values. Never expose DATABASE_URL, DIRECT_URL, or private keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=

# Server-only values
TURNSTILE_SECRET_KEY=
ORGANISER_PASSCODE=
ORGANISER_SESSION_SECRET=
APP_URL=
UPI_VPA=
UPI_PAYEE_NAME=
RESEND_API_KEY=
RESEND_FROM=
